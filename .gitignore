# Python environments, bytecode and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Packaging and coverage output
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local credentials (keep documented environment templates)
.env
.env.*
!.env.example
!.env.sample
.aws/

# Downloaded models and generated benchmark feature caches
*.gguf
*.safetensors
/bench/results/*.npz

# Runtime logs, editor leftovers and OS metadata
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Keep benchmark JSON reports and switch examples, tests and lock files:
# these describe measured results and reproducible decision behaviour.

# Training exports and their manifests
*.export.jsonl
*.export.jsonl.manifest.json

# Stable advisory lock sidecars
*.write-lock

/.artifacts/

# Resumable benchmark checkpoints
*.checkpoint.jsonl
*.checkpoint.jsonl.*
# Preserve the printer benchmark's generated evidence and review history.
/packs/*
!/packs/zt411/
work/

# Fetched proprietary source documents and their extracted excerpts
bench/data/*/sources/
