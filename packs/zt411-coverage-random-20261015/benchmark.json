  "rules": [
   {
    "id": "ZT-ASSET",
    "text": "Evidence about another printer establishes nothing about this one.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-CURRENT",
    "text": "A note older than a later state change does not establish current state.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-CONFLICT",
    "text": "Contradictory current indications leave a property unresolved, none preferred by recency or source; a decision is unresolved only if its possible values give different answers.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-COMMAND",
    "text": "A commanded or attempted action is not completion; only a verification establishes a completed step.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-METHOD-TT",
    "text": "With thermal-transfer media established and method direct thermal, setting thermal transfer is justified.",
    "source": "zt-user-guide"
   },
   {
    "id": "ZT-METHOD-DT",
    "text": "With direct-thermal media established and method thermal transfer, setting direct thermal is justified.",
    "source": "zt-user-guide"
   },
   {
    "id": "ZT-RIBBON",
    "text": "Thermal-transfer printing needs a loaded ribbon: with ribbon absence established, loading one is justified and returning to printing is prohibited.",
    "source": "zt-user-guide"
   },
   {
    "id": "ZT-CAL-START",
    "text": "A current media/ribbon detection symptom (an operator reporting an out indication despite loaded media, or a controller out alert while loaded) with consistent configuration justifies starting manual sensor calibration or verifying the loading.",
    "source": "zt-calibration"
   },
   {
    "id": "ZT-CAL-NEXT",
    "text": "Continuing a calibration prompt requires verified completion of that prompt's step; continuing without it is prohibited.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-CAL-CANCEL",
    "text": "Cancelling calibration leaves calibration incomplete; it is justified when calibration runs under a configuration inconsistent with the media.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-CAL-HOLD",
    "text": "Print-method changes wait until calibration is cancelled.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-RESUME",
    "text": "Returning to printing is prohibited during calibration, with a current unaddressed detection symptom or with configuration inconsistent with the media; it is justified when paused with consistent configuration and no such symptom.",
    "source": "zt-calibration"
   },
   {
    "id": "ZT-VERIFY",
    "text": "An unverified ribbon-load command or reported calibration step or completion justifies verifying it.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-DIAGNOSE",
    "text": "Requesting the observation an unresolved decision needs is justified.",
    "source": "benchmark convention"
   },
   {
    "id": "ZT-DEFAULT",
    "text": "An action no rule justifies is not justified.",
    "source": "benchmark convention"
   }
  ],
